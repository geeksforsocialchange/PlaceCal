<%# Directory and join components only appear on placecal.org, so they ignore the Theme menu (`@display context directory`) %>
<% theme = PlaceCal::Extensions.find_theme(lookbook_display(:theme)) unless lookbook_display(:context) == 'directory' %>
<%# `@display width page|form` renders a component inside the container it sits in on the site %>
<% width = lookbook_display(:width).to_s %>
<%# A width's container has its own side padding; full-width pieces opt out with `@display padding false` %>
<% page_padding = if width.present? then 'py-8'
                  elsif !lookbook_display(:padding).in?([false, 'false']) then 'p-8'
                  end %>
<!DOCTYPE html>
<html lang="en" <%= tag.attributes(data: { theme: theme&.data_theme }) %>>
<head>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'public_tailwind', media: 'all' %>
  <%= render Components::Shared::ThemeHead.new(theme:) if theme %>
  <%= stylesheet_link_tag URI.join(Rails.application.importmap.packages['maplibre-gl'].path, 'dist/maplibre-gl.css').to_s, media: 'all', id: 'maplibre-gl-css' %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <div class="page bg-background min-h-screen flow-root <%= page_padding %>">
    <% case width %>
    <% when 'page' %>
      <div class="container-public"><%= yield %></div>
    <% when 'form' %>
      <div class="container-public"><div class="max-w-(--width-prose) mx-auto"><%= yield %></div></div>
    <% else %>
      <%= yield %>
    <% end %>
  </div>
</body>
</html>
