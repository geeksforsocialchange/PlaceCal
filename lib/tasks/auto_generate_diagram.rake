# frozen_string_literal: true

# Only run in development: not appropriate for production.
#
# RailsERD.load_tasks adds the gem's own hook, which runs `erd` after
# db:migrate and db:migrate:{up,down,redo,reset,change}. `erd` writes
# doc/erd.mmd (see `filename` in .erdconfig). GitHub does not render bare .mmd
# files, so the action below also writes doc/erd.md, which wraps the same
# diagram in a ```mermaid block.
if Rails.env.development?
  RailsERD.load_tasks

  # The gem's hook leaves out db:rollback.
  namespace :db do
    task :rollback do # rubocop:disable Rake/Desc, Rails/RakeEnvironment
      ERDGraph::Migration.update_model
    end
  end

  Rake::Task['erd:generate'].enhance do
    mmd = Rails.root.join('doc/erd.mmd')
    Rails.root.join('doc/erd.md').write(<<~MARKDOWN)
      # Database schema diagram

      Entity-relationship diagram of PlaceCal's Active Record models. To keep it readable it shows only foreign keys and leaves out pure join tables; see [`db/schema.rb`](../db/schema.rb) for every column. Generated by `bin/rails erd` from `.erdconfig`, and again after every `db:migrate` and `db:rollback` in development. Do not edit by hand. The same diagram is in [`erd.mmd`](erd.mmd).

      ```mermaid
      ---
      config:
        er:
          nodeSpacing: 80
          rankSpacing: 60
      ---
      #{mmd.read.chomp}
      ```
    MARKDOWN
  end
end
