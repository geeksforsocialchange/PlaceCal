#!/usr/bin/env ruby
# frozen_string_literal: true

# The reusable CI workflow runs this under the runner's own Ruby, where
# Pathname is not preloaded (it is on Ruby 4, which is why RuboCop calls the
# require redundant).
require 'pathname' # rubocop:disable Lint/RedundantRequireStatement

# Writes <core>/Gemfile.extensions-dev: core's own Gemfile with one or more
# extension gems taken from a path checkout instead of the pinned git tag, so
# `bundle exec rspec` and `bundle exec rubocop` run against the working tree.
#
# Every extension the run does not name is left exactly as core pins it, so one
# boot still loads every extension. That matters: two engines registering two
# themes in one process is a thing core has to keep working, and a generator
# that dropped the whole :extensions group would hide a regression in it.
#
# Usage:
#   bin/extension-dev-gemfile [--core DIR] <gem>=<path> [<gem>=<path> ...]
#
# The paths are resolved as core sees them, because that is how Bundler reads
# them: from beside core's Gemfile.
#
#   bin/extension-dev-gemfile placecal-theme-transdimension=../placecal-theme-transdimension
#
# Then point BUNDLE_GEMFILE at the result:
#
#   PLACECAL_CORE_PATH=/path/to/PlaceCal \
#     BUNDLE_GEMFILE=/path/to/PlaceCal/Gemfile.extensions-dev \
#     RAILS_ENV=test bundle exec rspec
#
# The generated file is local to the core checkout and gitignored. See
# doc/extensions.md.

GENERATED = 'Gemfile.extensions-dev'
USAGE = 'Usage: bin/extension-dev-gemfile [--core DIR] <gem>=<path> [<gem>=<path> ...]'

def parse_argv(argv)
  argv = argv.dup
  core = nil

  if argv.first == '--core'
    argv.shift
    core = argv.shift
    abort "extension-dev-gemfile: --core needs a directory.\n#{USAGE}" if core.nil?
  end

  abort "extension-dev-gemfile: name at least one extension.\n#{USAGE}" if argv.empty?

  entries = argv.map do |pair|
    name, path = pair.split('=', 2)
    abort "extension-dev-gemfile: #{pair.inspect} is not <gem>=<path>.\n#{USAGE}" if name.to_s.empty? || path.to_s.empty?

    [name, path]
  end

  [core, entries]
end

core_arg, entries = parse_argv(ARGV)
core = Pathname.new(core_arg || File.expand_path('..', __dir__)).expand_path
gemfile = core.join('Gemfile')

abort "extension-dev-gemfile: no Gemfile at #{core}: pass --core with the PlaceCal checkout." unless gemfile.file?

source = gemfile.read
missing = entries.map(&:first).reject { |name| source.match?(/^\s*gem ['"]#{Regexp.escape(name)}['"]/) }
abort "extension-dev-gemfile: #{missing.join(', ')} is not in #{gemfile}." if missing.any?

# The generated file evaluates core's Gemfile with only the named gems' entries
# removed, then re-adds them as path entries. Reading core's Gemfile at
# evaluation time rather than copying it means the generated file does not go
# stale when core's Gemfile changes.
#
# Removing an entry is PlaceCal::ExtensionRelease's job, because a Gemfile
# entry may wrap over several lines (doc/extensions.md prints it that way) and
# a one-line regex would leave the orphaned `github:` and `tag:` lines behind,
# turning the generated Gemfile into a syntax error. The helper is required by
# the path it ships at in this checkout rather than relative to the generated
# file, because --core may name a directory that is not this one.
release_helper = File.expand_path('../lib/placecal/extension_release', __dir__)
strip_lines = entries.map do |name, _path|
  "core = PlaceCal::ExtensionRelease.strip_entry(core, #{name.inspect})"
end

# Inside `group :extensions do`, not at the top level: bin/check-extension-tree
# finds what to check by that group, so a path entry outside it would leave the
# gem under test unchecked while its sibling, still at its tag, passed.
path_lines = entries.map { |name, path| "  gem #{name.inspect}, path: #{path.inspect}" }

core.join(GENERATED).write(<<~RUBY)
  # Generated by bin/extension-dev-gemfile. Local only, do not commit.
  # Core's Gemfile with #{entries.map(&:first).join(', ')} taken from a path
  # checkout; every other extension stays at the tag core pins.
  require #{release_helper.inspect}
  core = File.read(File.expand_path('Gemfile', __dir__))
  #{strip_lines.join("\n")}
  instance_eval(core, File.expand_path('Gemfile', __dir__), 1)
  group :extensions do
  #{path_lines.join("\n")}
  end
RUBY

puts "Wrote #{core.join(GENERATED)}"
entries.each { |name, path| puts "  #{name} -> #{path}" }
