#!/usr/bin/env ruby
# frozen_string_literal: true

# Opens a pin PR per extension with a newer tag, once per version. Plain Ruby; DRY_RUN=1 only prints.

require 'json'
require 'open3'
require_relative '../lib/placecal/extension_release'
require_relative '../lib/placecal/extension_pin_plan'

DRY_RUN = ENV['DRY_RUN'] == '1'
ENTRY = /gem\s+['"]([^'"]+)['"],\s*github:\s*['"]([^'"]+)['"],\s*tag:\s*['"]v?(\d+\.\d+\.\d+)['"]/

def run!(*cmd)
  out, status = Open3.capture2(*cmd)
  abort "#{cmd.join(' ')} failed" unless status.success?
  out
end

def latest_tag(repo)
  names = run!('gh', 'api', "repos/#{repo}/tags", '--paginate', '--jq', '.[].name').split
  names.filter_map { |n| n.delete_prefix('v') if n.match?(/\Av\d+\.\d+\.\d+\z/) }
       .max_by { |v| Gem::Version.new(v) }
end

def gh_json(*)
  JSON.parse(run!('gh', *), symbolize_names: true)
end

def prs_from(branch)
  gh_json('pr', 'list', '--head', branch, '--state', 'all', '--json', 'number,state')
end

def open_prs
  @open_prs ||= gh_json('pr', 'list', '--state', 'open', '--limit', '200', '--json', 'number,headRefName')
                .map { |pr| { number: pr[:number], head: pr[:headRefName] } }
end

def open_pin_pr(name, repo, from, to, branch)
  return puts("#{name}: would pin v#{from} -> v#{to} on #{branch}") if DRY_RUN

  base = run!('git', 'rev-parse', '--abbrev-ref', 'HEAD').strip
  run!('git', 'checkout', '-q', '-B', branch)
  File.write('Gemfile', PlaceCal::ExtensionRelease.bump(File.read('Gemfile'), name, to))
  run!('bundle', 'lock', '--update', name)
  run!('git', 'commit', '-q', '-m', "Pin #{name} at v#{to}", '--', 'Gemfile', 'Gemfile.lock')
  run!('git', 'push', '-q', '--force', 'origin', branch)
  run!('gh', 'pr', 'create', '--base', base, '--head', branch, '--label', 'dependencies',
       '--title', "Pin #{name} at v#{to}",
       '--body', "Pins [#{name} v#{to}](https://github.com/#{repo}/releases/tag/v#{to}) " \
                 "(was v#{from}). Merging deploys it to staging.")
  run!('git', 'checkout', '-q', base)
  puts "#{name}: opened PR pinning v#{to}"
end

def close_superseded(name, plan)
  plan.close.each do |pr|
    next puts("#{name}: would close ##{pr[:number]} (v#{pr[:version]}), superseded by v#{plan.superseded_by}") if DRY_RUN

    run!('gh', 'pr', 'close', pr[:number].to_s, '--comment', "Superseded by v#{plan.superseded_by}.")
    puts "#{name}: closed ##{pr[:number]} (v#{pr[:version]}), superseded by v#{plan.superseded_by}"
  end
end

group = File.read('Gemfile')[/^group :extensions do\n(.*?)^end/m, 1].to_s
group.scan(ENTRY).each do |name, repo, current|
  latest = latest_tag(repo)
  target_prs = latest ? prs_from(PlaceCal::ExtensionPinPlan.branch(name, latest)) : []
  plan = PlaceCal::ExtensionPinPlan.call(name:, current:, latest:,
                                         target_prs:, open_prs:)

  if plan.action == :open
    open_pin_pr(name, repo, current, latest, plan.branch)
  else
    puts "#{name}: skipping, #{plan.reason}"
  end
  close_superseded(name, plan)
end
