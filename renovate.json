{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"helpers:pinGitHubActionDigests",
		"schedule:nonOfficeHours",
		"customManagers:dockerfileVersions"
	],
	"automerge": true,
	"automergeStrategy": "squash",
	"labels": ["dependencies"],
	"lockFileMaintenance": {
		"enabled": true
	},
	"rangeStrategy": "pin",
	"timezone": "Europe/London",
	"vulnerabilityAlerts": {
		"labels": ["security"]
	},
	"packageRules": [
		{
			"matchManagers": ["bundler"],
			"rangeStrategy": "update-lockfile"
		},
		{
			"matchDatasources": ["docker"],
			"matchPackageNames": ["postgres"],
			"matchCurrentVersion": "13.4",
			"allowedVersions": "13.4"
		},
		{
			"matchDatasources": ["npm", "rubygems"],
			"minimumReleaseAge": "7 days"
		},
		{
			"description": "The Ruby client drives the npm package's Playwright, so they update together",
			"matchPackageNames": ["playwright", "playwright-ruby-client"],
			"groupName": "playwright"
		},
		{
			"description": "Ruby patches wait a week so CI and Docker have builds, and land with the setup-ruby action that knows them",
			"matchDepNames": ["ruby"],
			"matchUpdateTypes": ["patch"],
			"groupName": "ruby",
			"minimumReleaseAge": "7 days"
		},
		{
			"matchDepNames": ["ruby/setup-ruby"],
			"groupName": "ruby"
		},
		{
			"description": "New Ruby minors are reviewed by hand, from their first patch release",
			"matchDepNames": ["ruby"],
			"matchUpdateTypes": ["minor", "major"],
			"automerge": false,
			"minimumReleaseAge": "7 days"
		},
		{
			"matchDepNames": ["ruby"],
			"allowedVersions": "!/^\\d+\\.\\d+\\.0$/"
		},
		{
			"groupName": "node version",
			"matchDepNames": ["node"],
			"matchManagers": ["nodenv", "npm", "custom.regex"]
		}
	]
}
