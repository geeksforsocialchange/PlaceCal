{
	"name": "placecal",
	"version": "3.0.0",
	"private": true,
	"dependencies": {
		"@tailwindcss/cli": "4.3.5"
	},
	"devDependencies": {
		"daisyui": "5.8.1",
		"husky": "9.1.7",
		"leaflet": "1.9.4",
		"lint-staged": "17.6.1",
		"playwright": "1.65.1",
		"prettier": "3.10.1",
		"tom-select": "2.7.0"
	},
	"scripts": {
		"build": "yarn css-admin && yarn css-public && yarn leaflet-images",
		"build:all": "yarn build",
		"css-admin": "./node_modules/.bin/tailwindcss -i ./app/tailwind/admin_tailwind.css -o ./app/assets/builds/admin_tailwind.css --minify",
		"css-public": "./node_modules/.bin/tailwindcss -i ./app/tailwind/public_tailwind.css -o ./app/assets/builds/public_tailwind.css --minify",
		"leaflet-images": "mkdir -p app/assets/builds/images && cp node_modules/leaflet/dist/images/*.png app/assets/builds/images/",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky install"
	},
	"lint-staged": {
		"*.{css,html,js,json,md,scss,yml}": "prettier --write",
		"{*.{rb,jbuilder,rake,ru},.simplecov,Gemfile,Rakefile}": "bundle exec rubocop --force-exclusion --autocorrect"
	},
	"engines": {
		"node": "26.13.0"
	}
}
